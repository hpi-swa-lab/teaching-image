'From Squeak6.1 of 30 August 2026 [latest update: #23979] on 12 October 2026 at 9:34:01 pm'!!HandMorph methodsFor: 'private events' stamp: 'ct 10/12/2026 21:33'!generateWindowEvent: evtBuf 	"Generate the appropriate window event for the given raw event buffer"	| evt |	evt := WindowEvent new.	evt setHand: self.	evt setTimeStamp: evtBuf second.	evt timeStamp = 0 ifTrue: [evt setTimeStamp: Sensor eventTimeNow].	evt action: evtBuf third.	evt rectangle: (Rectangle origin: evtBuf fourth @ evtBuf fifth corner: evtBuf sixth @ evtBuf seventh ).	(Smalltalk platformName = 'unix' and: [#(windowActivated windowDeactivated) includes: evt type]) ifTrue:		[^nil flag: #workaround "https://github.com/OpenSmalltalk/opensmalltalk-vm/issues/777"].	^evt! !